#!/bin/sh
# Environment for miz inside the snap: lets the staged pw-record find its
# libraries and the host's sockets.

arch_dir="$SNAP/usr/lib/${SNAP_LAUNCHER_ARCH_TRIPLET:-x86_64-linux-gnu}"
export LD_LIBRARY_PATH="$arch_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PIPEWIRE_MODULE_DIR="$arch_dir/pipewire-0.3"
export SPA_PLUGIN_DIR="$arch_dir/spa-0.2"
export PIPEWIRE_CONFIG_DIR="$SNAP/usr/share/pipewire"

# snapd gives the snap its own XDG_RUNTIME_DIR (/run/user/UID/snap.miz);
# PipeWire's and the compositor's sockets live in the parent directory.
user_runtime="${XDG_RUNTIME_DIR%/snap.$SNAP_INSTANCE_NAME}"
export PIPEWIRE_RUNTIME_DIR="$user_runtime"
case "$WAYLAND_DISPLAY" in
    "" | /*) ;;
    *) [ -e "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] ||
        export WAYLAND_DISPLAY="$user_runtime/$WAYLAND_DISPLAY" ;;
esac

if ! snapctl is-connected pipewire; then
    echo "miz: the pipewire interface isn't connected, so there is no audio." >&2
    echo "  Connect it with: sudo snap connect $SNAP_INSTANCE_NAME:pipewire" >&2
fi

exec "$@"
