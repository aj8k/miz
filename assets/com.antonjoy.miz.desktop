[Desktop Entry]
Type=Application
Name=miz
GenericName=Music Visualizer
Comment=Calm visuals for whatever is playing
# scripts/install.sh rewrites this to the absolute install path.
Exec=miz
Icon=com.antonjoy.miz
Terminal=false
Categories=AudioVideo;Audio;
Keywords=music;visualizer;spectrum;milkdrop;
StartupWMClass=com.antonjoy.miz
