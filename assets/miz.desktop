[Desktop Entry]
Type=Application
Name=miz
GenericName=Music Visualizer
Comment=Calm visuals for whatever is playing
# Replaced with the absolute install path by scripts/install.sh.
Exec=@BINDIR@/miz
Icon=miz
Terminal=false
Categories=AudioVideo;Audio;
Keywords=music;visualizer;spectrum;milkdrop;
StartupWMClass=miz
